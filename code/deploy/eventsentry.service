[Unit]
Description=EventSentry API Server
After=network.target mysql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/eventsentry/code
ExecStart=/usr/bin/node dist/boot.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
EnvironmentFile=/opt/eventsentry/.env

[Install]
WantedBy=multi-user.target
